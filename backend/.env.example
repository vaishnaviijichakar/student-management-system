# ==============================================================
# Environment Configuration - Student Management System
# Used for local development and reference for Render environment
# ==============================================================

PORT=5000
NODE_ENV=development

# --------------------------------------------------------------
# MongoDB Connection String
# IMPORTANT TIPS FOR SOLVING THE MONGODB URI ISSUE:
# 1. If your password contains special characters (@, #, $, %, &, :, /, ?),
#    our Mongo URI Doctor automatically URL-encodes them!
# 2. Make sure you replace <username> and <password> with your Atlas DB credentials.
# 3. Add 0.0.0.0/0 to MongoDB Atlas -> Network Access (IP Access List).
# --------------------------------------------------------------
MONGODB_URI=mongodb+srv://admin:YourPassword123@cluster0.abcde.mongodb.net/student_management_db?retryWrites=true&w=majority

# URL of your Vercel frontend (set after deploying frontend to Vercel)
FRONTEND_URL=https://your-vercel-app.vercel.app
